# PostgreSQL (pgsql:// is normalized to postgresql://)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# SFTP Teccaliance datapackage
SFTP_HOST=datapackage.tecalliance.net
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/D_TAF
SFTP_FILE_GLOB=*.7z
# SFTP_MAX_FILES=3

# Local .7z files for /supplier must live directly under this directory (e.g. Docker ./data:/data).
DATA_DIR=/data

# Row parsing: fixed_width (default) walks each line in column order; for varchar(n) the slice
# length is exactly n characters (same as information_schema.character_maximum_length).
# Integer/numeric use FIXED_WIDTH_* / numeric_precision. delimiter = split by FIELD_DELIMITER.
ROW_PARSE_MODE=fixed_width
FIELD_DELIMITER=;
FIXED_WIDTH_INTEGER=9
FIXED_WIDTH_BIGINT=18
FIXED_WIDTH_SMALLINT=5

TEXT_ENCODING=utf-8
PG_CLIENT_ENCODING=UTF8

# Log raw lines read from each data file: unset/0 = off; 5 = INFO first 5 records; all = DEBUG every record
# LOG_EXTRACTED_LINES=5
# LOG_EXTRACTED_LINES=all

SYNC_TRUNCATE=1
# /d-taf batch mode: 1 = TRUNCATE tecdoc_gheorghe once at batch start, then append suppliers.
# Resume for same job_id will NOT re-truncate.
# D_TAF_TRUNCATE_FIRST=0
EMPTY_AS_NULL=1
STRICT_TABLES=0

PORT=3000
SFTP_HOST_VERIFY=accept-new
