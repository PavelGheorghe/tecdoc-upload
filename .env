# PostgreSQL (pgsql:// is normalized to postgresql://)
DATABASE_URL=pgsql://pguserrec:JH%7BK%25ws%2A%3Dc9%23oCawi5@air12p-rds-ereliable.cbao66w2oetu.eu-central-1.rds.amazonaws.com:5432/ereliable

# SFTP Teccaliance datapackage
SFTP_HOST=datapackage.tecalliance.net
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/D_TAF
SFTP_FILE_GLOB=*.7z
# SFTP_MAX_FILES=3

# Local .7z files for /supplier must live directly under this directory (e.g. Docker ./data:/data).
DATA_DIR=/data

# fixed_width = TecDoc flat lines (varchar(n) slice lengths); delimiter = split by FIELD_DELIMITER
ROW_PARSE_MODE=fixed_width

FIELD_DELIMITER=;
TEXT_ENCODING=utf-8
PG_CLIENT_ENCODING=UTF8

SYNC_TRUNCATE=1
EMPTY_AS_NULL=1
STRICT_TABLES=0

D_TAF_TRUNCATE_FIRST=1

PORT=3000
SFTP_HOST_VERIFY=accept-new
